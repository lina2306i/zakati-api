{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lina2306i.github.io/zakati-api/schema/country.schema.json",
  "title": "Zakati API Country Dataset",
  "type": "object",
  "required": [
    "hijri_year",
    "gregorian_year",
    "last_updated",
    "country_code",
    "country_name_ar",
    "country_name_en",
    "currency",
    "official_source_url",
    "zakat_al_fitr",
    "zakat_categories",
    "asnaf_al_zakat"
  ],
  "properties": {
    "hijri_year": { "type": "integer", "minimum": 1400 },
    "gregorian_year": { "type": "integer", "minimum": 1980 },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date of last verified update (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "needs_update", "stub"]
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "country_name_ar": { "type": "string", "minLength": 1 },
    "country_name_en": { "type": "string", "minLength": 1 },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "official_source_url": { "type": "string", "format": "uri" },
    "zakat_al_fitr": {
      "type": "object",
      "required": ["notes_ar", "notes_en"],
      "properties": {
        "value_per_person": { "type": ["number", "null"] },
        "notes_ar": { "type": "string" },
        "notes_en": { "type": "string" }
      }
    },
    "zakat_categories": {
      "type": "object",
      "required": [
        "zakat_al_mal",
        "agriculture",
        "livestock",
        "treasures_and_minerals"
      ],
      "properties": {
        "zakat_al_mal": {
          "type": "object",
          "required": [
            "nisab_cash",
            "nisab_gold_grams",
            "nisab_silver_grams",
            "percentage_rate"
          ],
          "properties": {
            "nisab_cash": {
              "type": ["number", "null"],
              "description": "Cash Nisab in the country currency field (not currency-suffixed)"
            },
            "nisab_gold_grams": { "type": "number" },
            "nisab_silver_grams": { "type": "number" },
            "percentage_rate": { "type": "number" }
          }
        },
        "agriculture": {
          "type": "object",
          "required": ["nisab_value", "rates"],
          "properties": {
            "nisab_value": {
              "type": "number",
              "description": "Numeric Nisab for math (typically 5 awsuq)"
            },
            "nisab_unit": { "type": "string" },
            "nisab_kg_approx": { "type": ["number", "null"] },
            "rates": { "type": "array" }
          }
        },
        "livestock": {
          "type": "object",
          "required": ["sub_categories"],
          "properties": {
            "sub_categories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["nisab_value", "type_en", "type_ar"],
                "properties": {
                  "nisab_value": { "type": ["number", "null"] },
                  "nisab_unit": { "type": "string" }
                }
              }
            }
          }
        },
        "treasures_and_minerals": { "type": "object" }
      }
    },
    "asnaf_al_zakat": {
      "type": "object",
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "array", "minItems": 8, "maxItems": 8 },
        "en": { "type": "array", "minItems": 8, "maxItems": 8 }
      }
    }
  },
  "additionalProperties": true
}
